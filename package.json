{
  "name": "mfparis",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=2048\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "ci": "npm run payload migrate && npm run build",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:prod": "NODE_OPTIONS=--no-deprecation payload migrate",
    "coolify:build": "npm run migrate && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "socket": "node chat-server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "import:wp": "tsx src/scripts/import-wp-data.ts",
    "import:wp:taxonomies": "tsx src/scripts/import-wp-data.ts --only=taxonomies",
    "import:wp:brands": "tsx src/scripts/import-wp-data.ts --only=brands",
    "import:wp:product-categories": "tsx src/scripts/import-wp-data.ts --only=product-categories",
    "import:wp:post-categories": "tsx src/scripts/import-wp-data.ts --only=post-categories",
    "import:wp:products": "tsx src/scripts/import-wp-data.ts --only=products",
    "import:wp:posts": "tsx src/scripts/import-wp-data.ts --only=posts",
    "import:wp:products:no-media": "tsx src/scripts/import-wp-data.ts --only=products --skip-media",
    "import:wp:products:update": "tsx src/scripts/import-wp-data.ts --only=products --update",
    "import:wp:all": "tsx src/scripts/import-wp-data.ts --only=all",
    "convert:products-richtext": "tsx src/scripts/convert-products-html-to-richtext.ts",
    "convert:categories-desc": "tsx src/scripts/convert-categories-description.ts",
    "convert:brands-desc": "tsx src/scripts/convert-brands-description.ts",
    "convert:posts-content": "tsx src/scripts/convert-posts-content.ts",
    "clear:products": "tsx src/scripts/clear-data.ts",
    "redirects:backfill-products": "tsx src/scripts/backfill-wordpress-product-redirects.ts",
    "redirects:audit": "tsx src/scripts/audit-redirects.ts",
    "redirects:backfill-content": "tsx src/scripts/backfill-legacy-content-redirects.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/email-nodemailer": "^3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/richtext-lexical": "^3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@tailwindcss/postcss": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "graphql": "^16.8.1",
    "lucide-react": "^1.11.0",
    "next": "^16.2.7",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.3.0",
    "payload": "3.85.0",
    "postcss": "^8.5.12",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sharp": "0.34.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.3",
    "jsdom": "^28.1.0",
    "postgres": "^3.4.9",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 113",
      "safari >= 16.4",
      "ios_saf >= 16.4",
      "android >= 111"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
