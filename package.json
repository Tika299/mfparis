{
  "name": "mfparis",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=2048\" next build --webpack",
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev --webpack",
    "dev:turbo": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev",
    "devsafe": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\" && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev --webpack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "ci": "npm run payload migrate && npm run build",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:prod": "NODE_OPTIONS=--no-deprecation payload migrate",
    "coolify:build": "npm run migrate && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "socket": "node chat-server.js",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "import:wp": "tsx src/scripts/import-wp-data.ts",
    "import:wp:taxonomies": "tsx src/scripts/import-wp-data.ts --only=taxonomies",
    "import:wp:brands": "tsx src/scripts/import-wp-data.ts --only=brands",
    "import:wp:product-categories": "tsx src/scripts/import-wp-data.ts --only=product-categories",
    "import:wp:post-categories": "tsx src/scripts/import-wp-data.ts --only=post-categories",
    "import:wp:products": "tsx src/scripts/import-wp-data.ts --only=products",
    "import:wp:posts": "tsx src/scripts/import-wp-data.ts --only=posts",
    "import:wp:products:no-media": "tsx src/scripts/import-wp-data.ts --only=products --skip-media",
    "import:wp:products:update": "tsx src/scripts/import-wp-data.ts --only=products --update",
    "import:wp:all": "tsx src/scripts/import-wp-data.ts --only=all",
    "import:product-reviews": "tsx src/scripts/import-product-reviews.ts",
    "import:product-reviews:apply": "tsx src/scripts/import-product-reviews.ts --yes",
    "import:missing-media": "tsx src/scripts/import-missing-media-from-list.ts",
    "import:internal-links:wp": "tsx src/scripts/import-internal-link-rules-from-wp.ts",
    "clear:products": "tsx src/scripts/clear-imported-data.ts",
    "redirects:backfill-products": "tsx src/scripts/backfill-wordpress-product-redirects.ts",
    "redirects:audit": "tsx src/scripts/audit-redirects.ts",
    "redirects:backfill-content": "tsx src/scripts/backfill-legacy-content-redirects.ts",
    "redirects:backfill-blog": "tsx src/scripts/backfill-legacy-blog-redirects.ts",
    "repair:wp-images": "tsx src/scripts/repair-wordpress-lazy-images.ts",
    "sync:product-sku": "tsx src/scripts/sync-product-sku-from-wp-id.ts",
    "repair:html-entities": "tsx src/scripts/repair-html-entities.ts",
    "repair:media-filenames": "tsx src/scripts/repair-media-filenames.ts",
    "repair:media-filenames:apply": "tsx src/scripts/repair-media-filenames.ts --yes",
    "audit:broken-images": "tsx src/scripts/audit-broken-images.ts",
    "audit:internal-links": "tsx src/scripts/audit-internal-links.ts",
    "audit:internal-links:repair": "tsx src/scripts/audit-internal-links.ts --repair --yes",
    "repair:internal-link-anchors": "tsx src/scripts/repair-internal-link-anchors.ts",
    "repair:internal-link-anchors:apply": "tsx src/scripts/repair-internal-link-anchors.ts --yes",
    "audit:broken-images:not-in-media": "tsx src/scripts/filter-broken-images-not-in-media.ts",
    "repair:product-brands": "tsx src/scripts/repair-product-brands.ts",
    "backfill:product-search-keywords": "tsx src/scripts/backfill-product-search-keywords.ts",
    "db:search-indexes": "tsx src/scripts/create-search-indexes.ts",
    "repair:blog-content": "tsx src/scripts/repair-blog-content-from-wp.ts",
    "repair:imported-dates": "tsx src/scripts/repair-imported-dates.ts",
    "repair:imported-categories": "tsx src/scripts/repair-imported-categories.ts",
    "repair:blog-authors": "tsx src/scripts/assign-default-blog-author.ts",
    "sync:slugs": "tsx src/scripts/sync-slugs-from-wp-export.ts",
    "sync:slugs:apply": "tsx src/scripts/sync-slugs-from-wp-export.ts --yes",
    "sync:slugs:products": "tsx src/scripts/sync-slugs-from-wp-export.ts --only=products",
    "sync:slugs:products:apply": "tsx src/scripts/sync-slugs-from-wp-export.ts --only=products --yes",
    "sync:slugs:posts": "tsx src/scripts/sync-slugs-from-wp-export.ts --only=posts",
    "sync:slugs:posts:apply": "tsx src/scripts/sync-slugs-from-wp-export.ts --only=posts --yes",
    "silo:phase1-3": "tsx src/scripts/apply-silo-phase-1-3.ts",
    "silo:redirects": "tsx src/scripts/apply-silo-phase-1-3.ts --only=redirects --all-priorities",
    "silo:redirects:apply": "tsx src/scripts/apply-silo-phase-1-3.ts --only=redirects --all-priorities --apply-redirects --yes",
    "silo:blog-categories": "tsx src/scripts/apply-silo-phase-1-3.ts --only=blog --all-priorities",
    "silo:blog-categories:apply": "tsx src/scripts/apply-silo-phase-1-3.ts --only=blog --all-priorities --yes",
    "report:slug-mismatches": "tsx src/scripts/report-slug-mismatches.ts",
    "report:slug-mismatches:posts": "tsx src/scripts/report-slug-mismatches.ts --only=posts",
    "report:slug-mismatches:products": "tsx src/scripts/report-slug-mismatches.ts --only=products",
    "clear:internal-links": "tsx src/scripts/clear-internal-link-rules.ts",
    "repair:media-duplicates": "tsx src/scripts/repair-media-duplicates.ts",
    "repair:media-duplicates:apply": "tsx src/scripts/repair-media-duplicates.ts --yes --trust-name",
    "repair:content-image-urls": "tsx src/scripts/repair-content-upload-image-urls.ts",
    "repair:content-image-urls:apply": "tsx src/scripts/repair-content-upload-image-urls.ts --yes",
    "repair:media-missing-file-links": "tsx src/scripts/repair-media-missing-file-links.ts",
    "repair:media-missing-file-links:apply": "tsx src/scripts/repair-media-missing-file-links.ts --yes",
    "report:missing-media-files": "tsx src/scripts/report-missing-media-files.ts",
    "backfill:short-descriptions": "tsx src/scripts/backfill-short-descriptions.ts",
    "backfill:short-descriptions:apply": "tsx src/scripts/backfill-short-descriptions.ts --yes",
    "redirects:rebuild": "tsx src/scripts/rebuild-clean-redirects.ts",
    "redirects:rebuild:apply": "tsx src/scripts/rebuild-clean-redirects.ts --delete-existing --yes"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.85.0",
    "@payloadcms/email-nodemailer": "^3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tinymce/tinymce-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "dotenv": "^16.6.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "graphql": "^16.8.1",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.11.0",
    "next": "^16.2.7",
    "node-fetch": "^3.3.2",
    "p-limit": "^7.3.0",
    "payload": "3.85.0",
    "postcss": "^8.5.12",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.5.0",
    "sharp": "0.34.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.3",
    "jsdom": "^28.1.0",
    "postgres": "^3.4.9",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "browserslist": {
    "production": [
      "chrome >= 111",
      "edge >= 111",
      "firefox >= 113",
      "safari >= 16.4",
      "ios_saf >= 16.4",
      "android >= 111"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
